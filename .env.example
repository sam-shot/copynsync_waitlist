# Copynsync Backend API URL
# - Production Deployment: set this in your deployment dashboard (e.g., Vercel) to your live backend endpoint
#   Example: NEXT_PUBLIC_API_URL="https://api.copynsync.com"
# - Local Dev: http://localhost:3000 or your LAN IP (e.g., http://192.168.18.42:3000)
NEXT_PUBLIC_API_URL="https://api.copynsync.com"
